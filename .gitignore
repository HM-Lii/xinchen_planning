# CMake build directories
/build/
/build-*/
/cmake-build-*/
/out/

# CMake-generated files (for accidental in-source builds)
/CMakeCache.txt
/CMakeFiles/
/cmake_install.cmake
/CTestTestfile.cmake
/Testing/
/compile_commands.json

# Compiled objects and binaries
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out

# Test and coverage output
*.gcda
*.gcno
*.gcov
coverage/
/logs/
/.deps/

# Python bytecode caches
__pycache__/
*.py[cod]

# Editor and OS metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local agent configuration and skills
/.agents/
